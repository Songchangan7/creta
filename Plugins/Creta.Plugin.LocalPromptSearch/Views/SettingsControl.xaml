<UserControl
    x:Class="Creta.Plugin.LocalPromptSearch.Views.SettingsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    MinWidth="420">
    <StackPanel Margin="12">
        <TextBlock
            Margin="0,0,0,8"
            FontSize="16"
            FontWeight="SemiBold"
            Text="Local Prompt Search" />
        <TextBlock
            Margin="0,0,0,12"
            Foreground="Gray"
            Text="c 后面的文字会直接存为 Prompt 正文，可用 #标签；只输入 c 时才保存剪贴板。v 搜索已保存的提示词，pt 仍可作为 v 的别名。"
            TextWrapping="Wrap" />
        <TextBlock
            Margin="0,0,0,6"
            Text="Prompt 模板文件路径" />
        <TextBox
            Margin="0,0,0,8"
            Text="{Binding PromptFilePath, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock
            Margin="0,0,0,12"
            Foreground="Gray"
            Text="留空时默认读取插件目录中的 prompts.json；也可以填写自定义绝对路径或带环境变量的路径。" 
            TextWrapping="Wrap" />
        <CheckBox
            Margin="0,0,0,12"
            Checked="PasteAfterCopy_OnChanged"
            Content="复制后自动粘贴到原输入框"
            IsChecked="{Binding PasteAfterCopy, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            Unchecked="PasteAfterCopy_OnChanged" />
        <Button
            Width="120"
            HorizontalAlignment="Left"
            Click="ReloadButton_OnClick"
            Content="保存并重载" />
    </StackPanel>
</UserControl>
