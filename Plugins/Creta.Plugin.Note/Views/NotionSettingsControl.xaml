<UserControl
    x:Class="Creta.Plugin.Note.Views.NotionSettingsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    MinWidth="420">
    <StackPanel Margin="12">
        <CheckBox
            Margin="0,0,0,12"
            Content="{DynamicResource creta_plugin_note_settings_notion_enable}"
            IsChecked="{Binding NotionSyncEnabled, Mode=TwoWay}" />
        <TextBlock
            Margin="0,0,0,12"
            Foreground="Gray"
            Text="{DynamicResource creta_plugin_note_settings_notion_hint}"
            TextWrapping="Wrap" />
        <TextBlock
            Margin="0,0,0,6"
            Text="{DynamicResource creta_plugin_note_settings_notion_token_label}" />
        <PasswordBox
            x:Name="TokenBox"
            Margin="0,0,0,12"
            PasswordChanged="TokenBox_OnPasswordChanged" />
        <TextBlock
            Margin="0,0,0,6"
            Text="{DynamicResource creta_plugin_note_settings_notion_database_label}" />
        <TextBox
            Margin="0,0,0,12"
            Text="{Binding NotionDatabaseId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <StackPanel Margin="0,0,0,12" Orientation="Horizontal">
            <Button
                MinWidth="96"
                Margin="0,0,8,0"
                Click="TestButton_OnClick"
                Content="{DynamicResource creta_plugin_note_settings_notion_test}" />
            <Button
                MinWidth="96"
                Click="SaveButton_OnClick"
                Content="{DynamicResource creta_plugin_note_settings_notion_save}" />
        </StackPanel>
        <TextBlock
            Foreground="Gray"
            Text="{Binding StatusText}"
            TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
