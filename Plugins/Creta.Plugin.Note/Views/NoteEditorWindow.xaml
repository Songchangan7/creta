<Window
    x:Class="Creta.Plugin.Note.Views.NoteEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="{DynamicResource creta_plugin_note_editor_window_title}"
    Width="680"
    Height="580"
    MinWidth="560"
    MinHeight="460"
    AllowDrop="True"
    Background="{DynamicResource PopupBGColor}"
    Foreground="{DynamicResource PopupTextColor}"
    ResizeMode="CanResize"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="80" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Margin="26 18 26 12">
                <TextBlock
                    x:Name="EditorTitle"
                    FontSize="22"
                    FontWeight="SemiBold"
                    TextAlignment="Left" />
                <TextBlock
                    x:Name="EditorSubtitle"
                    Margin="0 10 0 0"
                    FontSize="14"
                    TextWrapping="Wrap" />
            </StackPanel>

            <Button
                Grid.Column="1"
                Click="CancelEdit"
                Style="{StaticResource TitleBarCloseButtonStyle}">
                <Path
                    Width="46"
                    Height="32"
                    Data="M 18,11 27,20 M 18,20 27,11"
                    Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                    StrokeThickness="1" />
            </Button>
        </Grid>

        <Grid Grid.Row="1" Margin="26 0 26 18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0 0 0 12">
                <ItemsControl x:Name="AttachmentList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Width="128"
                                Height="88"
                                Margin="0 0 8 8"
                                Background="{DynamicResource PopupButtonAreaBGColor}"
                                BorderBrush="{DynamicResource PopupButtonAreaBorderColor}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Cursor="Hand"
                                MouseLeftButtonUp="PreviewAttachment">
                                <Border.ContextMenu>
                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                        <MenuItem
                                            Click="PreviewAttachmentMenu"
                                            Header="{DynamicResource creta_plugin_note_editor_attachment_preview}" />
                                        <MenuItem
                                            Click="SaveAttachmentAs"
                                            Header="{DynamicResource creta_plugin_note_editor_attachment_save_as}" />
                                        <MenuItem
                                            Click="DeleteAttachmentMenu"
                                            Header="{DynamicResource creta_plugin_note_editor_attachment_delete}" />
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Grid>
                                    <Image
                                        Margin="4"
                                        Source="{Binding Thumbnail}"
                                        Stretch="Uniform" />
                                    <Button
                                        Width="22"
                                        Height="22"
                                        Margin="0 4 4 0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Click="DeleteAttachmentButton"
                                        Content="×"
                                        FontSize="12"
                                        Padding="0" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock
                    x:Name="AttachmentHint"
                    FontSize="12"
                    Opacity="0.72"
                    Text="{DynamicResource creta_plugin_note_editor_attachment_hint}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <TextBox
                x:Name="EditorTextBox"
                Grid.Row="1"
                AcceptsReturn="True"
                AcceptsTab="True"
                HorizontalScrollBarVisibility="Disabled"
                TextWrapping="Wrap"
                VerticalScrollBarVisibility="Auto" />
        </Grid>

        <Border
            Grid.Row="2"
            Background="{DynamicResource PopupButtonAreaBGColor}"
            BorderBrush="{DynamicResource PopupButtonAreaBorderColor}"
            BorderThickness="0 1 0 0">
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <Button
                    x:Name="CancelButton"
                    MinWidth="150"
                    Margin="0 0 6 0"
                    Click="CancelEdit" />
                <Button
                    x:Name="ConfirmButton"
                    MinWidth="150"
                    Margin="6 0 0 0"
                    Click="ConfirmEdit"
                    Style="{DynamicResource AccentButtonStyle}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
