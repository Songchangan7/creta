<UserControl
    x:Class="Creta.Plugin.Note.Views.NotesManagerControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    MinWidth="560"
    MinHeight="360">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="True">
            <Button
                Width="96"
                Margin="8,0,0,0"
                Click="RefreshButton_OnClick"
                Content="{DynamicResource creta_plugin_note_settings_notes_refresh}"
                DockPanel.Dock="Right" />
            <TextBlock VerticalAlignment="Center" Text="{Binding SummaryText}" TextWrapping="Wrap" />
        </DockPanel>

        <TextBlock
            Grid.Row="1"
            Margin="0,0,0,8"
            Foreground="Gray"
            Text="{Binding LoadErrorText}"
            TextWrapping="Wrap"
            Visibility="{Binding HasLoadError, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                Grid.Column="0"
                Margin="0,0,8,0"
                VerticalContentAlignment="Center"
                ToolTipService.ShowOnDisabled="True"
                ToolTip="{DynamicResource creta_plugin_note_settings_notes_search_hint}"
                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            <ComboBox
                x:Name="StatusFilterComboBox"
                Grid.Column="1"
                MinWidth="132"
                SelectionChanged="StatusFilterComboBox_OnSelectionChanged" />
        </Grid>

        <WrapPanel Grid.Row="3" Margin="0,0,0,8">
            <Button
                MinWidth="88"
                Margin="0,0,8,8"
                Click="EditSelectedButton_OnClick"
                Content="{DynamicResource creta_plugin_note_settings_notes_toolbar_edit}"
                IsEnabled="{Binding HasSingleSelection}" />
            <Button
                MinWidth="88"
                Margin="0,0,8,8"
                Click="EditTagsSelectedButton_OnClick"
                Content="{DynamicResource creta_plugin_note_settings_notes_toolbar_edit_tags}"
                IsEnabled="{Binding HasSingleSelection}" />
            <Button
                MinWidth="88"
                Margin="0,0,8,8"
                Click="DeleteSelectedButton_OnClick"
                Content="{DynamicResource creta_plugin_note_settings_notes_toolbar_delete}"
                IsEnabled="{Binding HasAnySelection}" />
            <Button
                MinWidth="88"
                Margin="0,0,8,8"
                Click="BatchArchiveButton_OnClick"
                Content="{DynamicResource creta_plugin_note_settings_notes_toolbar_batch_archive}"
                IsEnabled="{Binding HasAnySelection}" />
            <Button
                MinWidth="88"
                Margin="0,0,8,8"
                Click="BatchAddTagsButton_OnClick"
                Content="{DynamicResource creta_plugin_note_settings_notes_toolbar_batch_add_tags}"
                IsEnabled="{Binding HasAnySelection}" />
            <Button
                MinWidth="88"
                Margin="0,0,8,8"
                Click="ExportTextButton_OnClick"
                Content="{DynamicResource creta_plugin_note_settings_notes_toolbar_export_txt}"
                IsEnabled="{Binding HasAnySelection}" />
            <Button
                MinWidth="88"
                Margin="0,0,8,8"
                Click="ExportMarkdownButton_OnClick"
                Content="{DynamicResource creta_plugin_note_settings_notes_toolbar_export_md}"
                IsEnabled="{Binding HasAnySelection}" />
            <Button
                MinWidth="88"
                Margin="0,0,8,8"
                Click="ExportFilteredTextButton_OnClick"
                Content="{DynamicResource creta_plugin_note_settings_notes_toolbar_export_filtered_txt}"
                IsEnabled="{Binding HasNotes}" />
            <Button
                MinWidth="88"
                Margin="0,0,8,8"
                Click="ExportFilteredMarkdownButton_OnClick"
                Content="{DynamicResource creta_plugin_note_settings_notes_toolbar_export_filtered_md}"
                IsEnabled="{Binding HasNotes}" />
            <Button
                MinWidth="88"
                Margin="0,0,8,8"
                Click="ExportAllTextButton_OnClick"
                Content="{DynamicResource creta_plugin_note_settings_notes_toolbar_export_all_txt}"
                IsEnabled="{Binding HasAnyNotes}" />
            <Button
                MinWidth="88"
                Margin="0,0,8,8"
                Click="ExportAllMarkdownButton_OnClick"
                Content="{DynamicResource creta_plugin_note_settings_notes_toolbar_export_all_md}"
                IsEnabled="{Binding HasAnyNotes}" />
            <Button
                MinWidth="88"
                Margin="0,0,8,8"
                Click="BackupJsonButton_OnClick"
                Content="{DynamicResource creta_plugin_note_settings_notes_toolbar_backup_json}" />
            <Button
                MinWidth="88"
                Margin="0,0,8,8"
                Click="BackupFullButton_OnClick"
                Content="{DynamicResource creta_plugin_note_settings_notes_toolbar_backup_full}" />
            <Button
                MinWidth="88"
                Margin="0,0,8,8"
                Click="ImportButton_OnClick"
                Content="{DynamicResource creta_plugin_note_settings_notes_toolbar_import}" />
            <Button
                MinWidth="88"
                Margin="0,0,8,8"
                Click="OpenFolderButton_OnClick"
                Content="{DynamicResource creta_plugin_note_settings_notes_toolbar_open_folder}" />
        </WrapPanel>

        <TextBlock
            Grid.Row="4"
            Margin="0,0,0,8"
            Foreground="Gray"
            Text="{DynamicResource creta_plugin_note_settings_notes_sort_hint}"
            TextWrapping="Wrap" />

        <ListView
            x:Name="NotesListView"
            Grid.Row="5"
            BorderBrush="DarkGray"
            BorderThickness="1"
            GridViewColumnHeader.Click="GridViewColumnHeader_OnClick"
            ItemsSource="{Binding VisibleNotes}"
            MouseDoubleClick="NotesListView_MouseDoubleClick"
            SelectionChanged="NotesListView_OnSelectionChanged"
            SelectionMode="Extended"
            SizeChanged="NotesListView_SizeChanged"
            Style="{StaticResource {x:Static GridView.GridViewStyleKey}}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="{DynamicResource creta_plugin_note_settings_notes_column_content}">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock
                                    Margin="0,6"
                                    Text="{Binding ContentSummary}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTip="{Binding ContentToolTip}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="{DynamicResource creta_plugin_note_settings_notes_column_attachments}">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock
                                    Margin="0,6"
                                    HorizontalAlignment="Center"
                                    Text="{Binding AttachmentText}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="{DynamicResource creta_plugin_note_settings_notes_column_tags}">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,4" LastChildFill="True">
                                    <Button
                                        MinWidth="44"
                                        Margin="6,0,0,0"
                                        Click="EditTagsRowButton_OnClick"
                                        Content="{DynamicResource creta_plugin_note_settings_notes_edit_tags}"
                                        DockPanel.Dock="Right"
                                        Tag="{Binding}" />
                                    <TextBlock
                                        Margin="0,6"
                                        Text="{Binding TagsText}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{Binding TagsText}" />
                                </DockPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="{DynamicResource creta_plugin_note_settings_notes_column_created}">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Margin="0,6" Text="{Binding CreatedAtText}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="{DynamicResource creta_plugin_note_settings_notes_column_updated}">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Margin="0,6" Text="{Binding UpdatedAtText}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="{DynamicResource creta_plugin_note_settings_notes_column_pinned}">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Click="PinnedCheckBox_OnClick"
                                    IsChecked="{Binding IsPinned, Mode=OneWay}"
                                    IsEnabled="{Binding CanTogglePinned}"
                                    Tag="{Binding}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="{DynamicResource creta_plugin_note_settings_notes_column_archived}">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Click="ArchivedCheckBox_OnClick"
                                    IsChecked="{Binding IsArchived, Mode=OneWay}"
                                    Tag="{Binding}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="{DynamicResource creta_plugin_note_settings_notes_column_actions}">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,4" Orientation="Horizontal">
                                    <Button
                                        MinWidth="52"
                                        Margin="0,0,6,0"
                                        Click="EditRowButton_OnClick"
                                        Content="{DynamicResource creta_plugin_note_settings_notes_edit}"
                                        Tag="{Binding}" />
                                    <Button
                                        MinWidth="52"
                                        Click="DeleteRowButton_OnClick"
                                        Content="{DynamicResource creta_plugin_note_settings_notes_delete}"
                                        Tag="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <DockPanel Grid.Row="6" Margin="0,8,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button
                    Width="88"
                    Margin="0,0,8,0"
                    Click="PreviousPageButton_OnClick"
                    Content="{DynamicResource creta_plugin_note_settings_notes_page_prev}"
                    IsEnabled="{Binding CanGoPrevious}" />
                <Button
                    Width="88"
                    Click="NextPageButton_OnClick"
                    Content="{DynamicResource creta_plugin_note_settings_notes_page_next}"
                    IsEnabled="{Binding CanGoNext}" />
            </StackPanel>
            <TextBlock VerticalAlignment="Center" Text="{Binding PageInfoText}" />
        </DockPanel>
    </Grid>
</UserControl>
